# ============================================================================
# HaacoPro · Variables de entorno
# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
# ============================================================================

# URL del proyecto Supabase (ej. https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública / anon. Es la que usa el navegador; está protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio. La usan los scripts de administración (seed, importaciones)
# y, dentro de la app, el alta y el borrado de usuarios: un perfil cuelga de un
# usuario de Auth y crearlo no se puede con la sesión de nadie. Tiene que estar
# también en el entorno de producción o esa pantalla no podrá dar de alta.
# NUNCA la expongas en el cliente ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión a Postgres, para cargar el seed desde la terminal.
# Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# Sugerencias de domicilio en cotizaciones y clientes (Google Cloud →
# «Places API», la clásica). Vive sólo en el servidor: el navegador pregunta
# a /api/lugares y esa ruta consulta a Google. Sin ella el campo sigue
# funcionando como texto libre.
GOOGLE_PLACES_API_KEY=

# Lectura de tickets al registrar un gasto (console.anthropic.com → API keys).
# También vive sólo en el servidor: el navegador manda la foto a /api/ticket y
# esa ruta consulta a Claude. Sin ella el gasto se captura a mano, como antes.
ANTHROPIC_API_KEY=

# La ronda de precios de la mañana (/api/cron/precios) y los recordatorios
# (/api/cron/recordatorios). La inventas tú y la pones igual en Vercel: es lo
# único que separa a los crons de cualquiera, porque corren sin sesión. Sin
# ella las rutas contestan 501 y no hacen nada.
CRON_SECRET=

# Avisos en el teléfono. Se generan una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública va también al navegador (por eso lleva NEXT_PUBLIC_) y es la que
# firma la suscripción; la privada firma los envíos y nunca sale del servidor.
# Si se cambian, todos los teléfonos dados de alta dejan de recibir y hay que
# volver a activarlos uno por uno. Sin ellas el botón de avisos no se pinta y
# el cron contesta 501: los recordatorios siguen viéndose en el tablero.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A quién le escribe el servicio de push si un envío da problemas. Va en el
# encabezado de cada notificación; con el correo de la empresa basta.
CORREO_AVISOS=

# Datos de la empresa que aparecen en los documentos
NEXT_PUBLIC_EMPRESA_NOMBRE="HAACO PRO RECUBRIMIENTOS"
NEXT_PUBLIC_EMPRESA_DIRECTOR="Lic. Luis Enrique Inda Franco"
NEXT_PUBLIC_EMPRESA_CIUDAD="Hermosillo, Sonora"
NEXT_PUBLIC_EMPRESA_TELEFONO=""
NEXT_PUBLIC_EMPRESA_CORREO=""
