# ============================================================================
# HaacoPro · Variables de entorno
# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
# ============================================================================

# URL del proyecto Supabase (ej. https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública / anon. Es la que usa el navegador; está protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio. SÓLO para scripts de administración (crear usuarios, seed).
# NUNCA la expongas en el cliente ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión a Postgres, para cargar el seed desde la terminal.
# Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# Datos de la empresa que aparecen en los documentos
NEXT_PUBLIC_EMPRESA_NOMBRE="HAACO PRO RECUBRIMIENTOS"
NEXT_PUBLIC_EMPRESA_DIRECTOR="Lic. Luis Enrique Inda Franco"
NEXT_PUBLIC_EMPRESA_CIUDAD="Hermosillo, Sonora"
NEXT_PUBLIC_EMPRESA_TELEFONO=""
NEXT_PUBLIC_EMPRESA_CORREO=""
