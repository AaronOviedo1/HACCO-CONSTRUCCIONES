{
  "name": "haacopro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "iconos": "node scripts/generar-iconos.mjs",
    "novedades:imagenes": "node scripts/generar-novedades.mjs",
    "imagotipo": "node scripts/extraer-imagotipo.mjs",
    "probar:cuadre": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probar-cuadre.mjs",
    "probar:cobranza": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probar-cobranza.mjs",
    "bd:enlazar": "npx supabase link",
    "bd:push": "node --env-file=.env.local scripts/aplicar-migraciones.mjs",
    "bd:seed": "node --env-file=.env.local scripts/cargar-seed.mjs",
    "bd:demo": "node --env-file=.env.local scripts/datos-demo.mjs",
    "bd:reales": "node --env-file=.env.local scripts/datos-reales.mjs",
    "bd:revisar-contratos": "node --env-file=.env.local scripts/revisar-contratos-importados.mjs",
    "bd:respaldar": "node --env-file=.env.local.produccion.bak scripts/respaldar-produccion.mjs",
    "bd:clonar": "node --env-file=.env.local scripts/clonar-a-local.mjs",
    "bd:clonar:todo": "npm run bd:respaldar && npm run bd:clonar -- --si",
    "precios:sembrar": "node --env-file=.env.local scripts/sembrar-precios.mjs",
    "usuarios:demo": "node --env-file=.env.local scripts/crear-usuarios-demo.mjs",
    "usuarios:reales": "node --env-file=.env.local scripts/crear-trabajadores.mjs",
    "tipos": "npx supabase gen types typescript --linked > types/supabase.ts",
    "bd:push:cli": "npx supabase db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
